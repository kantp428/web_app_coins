{
  "info": {
    "name": "THAI Please",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Coin rate schema 2026-10-12: shared coin_rate_periods + per-shop shop_coin_rates added. Storage only; no rate endpoints or changed request bodies. F06/F08 generation and award linkage pending."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "customerUsername",
      "value": "0000000000000"
    },
    {
      "key": "sellerUsername",
      "value": "seller"
    },
    {
      "key": "governmentUsername",
      "value": "government"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "registerCustomerUsername",
      "value": "0000000000001"
    },
    {
      "key": "registerSellerUsername",
      "value": "register_shop"
    },
    {
      "key": "registerGovernmentUsername",
      "value": "register_government"
    }
  ],
  "item": [
    {
      "name": "List shop categories (save categoryId)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/categories"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "const categories = pm.response.json();",
              "if (categories.length) pm.collectionVariables.set(\"categoryId\", categories[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login CUSTOMER — 200 (configured credentials)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{customerUsername}}\", \"password\": \"{{password}}\", \"role\": \"CUSTOMER\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
