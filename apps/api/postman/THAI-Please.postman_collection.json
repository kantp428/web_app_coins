{
  "info": {
    "name": "THAI Please",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "customerUsername",
      "value": "0000000000000"
    },
    {
      "key": "sellerUsername",
      "value": "seller"
    },
    {
      "key": "governmentUsername",
      "value": "government"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "registerCustomerUsername",
      "value": "0000000000001"
    },
    {
      "key": "registerSellerUsername",
      "value": "register_shop"
    },
    {
      "key": "registerGovernmentUsername",
      "value": "register_government"
    }
  ],
  "item": [
    {
      "name": "Login CUSTOMER \u2014 200 (configured credentials)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{customerUsername}}\", \"password\": \"{{password}}\", \"role\": \"CUSTOMER\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
