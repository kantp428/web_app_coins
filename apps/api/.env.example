# Nest loads this file through ConfigModule.
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thai_please?schema=public

# Required: random private secret of at least 32 bytes; never commit a real secret.
JWT_SECRET=replace-with-a-long-random-secret

# Browser origin for the upcoming API CORS configuration.
WEB_ORIGIN=http://localhost:3001

# Development-only wallet controls. Keep false in production.
ENABLE_TEST_WALLET_ACTIONS=false

# Ensure current shop Coin rates on startup and every minute (06:00/18:00 Bangkok).
ENABLE_AUTO_COIN_RATES=true

# Runtime-configurable reverse geocoding provider (single API instance limiter)
GEOCODING_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
GEOCODING_USER_AGENT=THAI-Please-ShopRegistration/1.0
