# Nest loads this file through ConfigModule. DATABASE_URL is for the upcoming Prisma setup.
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thai_please?schema=public

# Add a real private value when implementing F02 authentication.
JWT_SECRET=replace-with-a-long-random-secret

# Browser origin for the upcoming API CORS configuration.
WEB_ORIGIN=http://localhost:3001
