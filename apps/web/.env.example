# Server-only Nest API URL for login and session checks
API_URL=http://localhost:3000

# Server-only OSRM endpoint; demo service matches osrm-test.html
OSRM_BASE_URL=https://router.project-osrm.org

# Optional OSM-compatible tile provider (visible attribution required)
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
