# Server-only Nest API URL for login and session checks
API_URL=http://localhost:3000

# Server-only FastAPI chatbot URL; browser uses same-origin /api/chat.
AI_SERVICE_URL=http://127.0.0.1:8000

# Optional exact tunnel hostname(s), comma-separated, without https://.
# Restart next dev after changing this value or creating a new Quick Tunnel.
DEV_ALLOWED_HOSTS=

# Server-only OSRM endpoint; demo service matches osrm-test.html
OSRM_BASE_URL=https://router.project-osrm.org

# Optional OSM-compatible tile provider (visible attribution required)
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Exact external origin for mutation CSRF checks behind a reverse proxy.
WEB_PUBLIC_ORIGIN=
