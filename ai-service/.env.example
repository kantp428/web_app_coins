# Server running Ollama native API (no /api suffix).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
# NestJS URL/PORT, not the Next.js frontend. Requires CUSTOMER Bearer token.
BACKEND_BASE_URL=http://127.0.0.1:3000
BACKEND_TIMEOUT_SECONDS=15
# Public spending/program information via DDGS; no API key needed.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_SEARCH_MAX_RESULTS=3
