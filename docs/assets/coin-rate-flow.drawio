<mxfile host="app.diagrams.net"><diagram id="coin-rate-flow" name="การปรับเรต Coins"><mxGraphModel dx="1000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Flow การปรับเรต Coins" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="100" y="20" width="600" height="50" as="geometry"/></mxCell><mxCell id="gov" value="Gov ปรับกติกา Coins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" vertex="1" parent="1"><mxGeometry x="260" y="100" width="280" height="60" as="geometry"/></mxCell><mxCell id="version" value="บันทึกกฎเวอร์ชันใหม่&lt;br&gt;มีผลตั้งแต่รอบถัดไป" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" vertex="1" parent="1"><mxGeometry x="260" y="190" width="280" height="70" as="geometry"/></mxCell><mxCell id="clock" value="ถึงรอบ 06:00 หรือ 18:00 น.&lt;br&gt;(Asia/Bangkok)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;" vertex="1" parent="1"><mxGeometry x="260" y="310" width="280" height="75" as="geometry"/></mxCell><mxCell id="rule" value="เลือกกฎที่มีผลตอนเริ่มรอบ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;" vertex="1" parent="1"><mxGeometry x="260" y="425" width="280" height="60" as="geometry"/></mxCell><mxCell id="shops" value="ดึงร้านที่ได้รับอนุมัติ (APPROVED)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;" vertex="1" parent="1"><mxGeometry x="260" y="525" width="280" height="60" as="geometry"/></mxCell><mxCell id="sales" value="รวมยอดขายย้อนหลังของแต่ละร้าน&lt;br&gt;ตามจำนวนวันที่กำหนดในกฎ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;" vertex="1" parent="1"><mxGeometry x="260" y="625" width="280" height="70" as="geometry"/></mxCell><mxCell id="calc" value="คำนวณเรต Coins ใหม่ของแต่ละร้าน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;" vertex="1" parent="1"><mxGeometry x="260" y="735" width="280" height="60" as="geometry"/></mxCell><mxCell id="save" value="บันทึกเรตประจำรอบและ Snapshot&lt;br&gt;เก็บประวัติเรตเดิมไว้" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=17;" vertex="1" parent="1"><mxGeometry x="260" y="835" width="280" height="70" as="geometry"/></mxCell><mxCell id="use" value="ใช้เรตคงที่ตลอดรอบ 12 ชั่วโมง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=17;" vertex="1" parent="1"><mxGeometry x="260" y="945" width="280" height="65" as="geometry"/></mxCell><mxCell id="note" value="อัปเดตเรตวันละ 2 รอบ แม้ Gov ไม่ปรับกฎ&lt;br&gt;การปรับกฎไม่เปลี่ยนเรตกลางรอบ" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="100" y="1080" width="600" height="70" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="gov" target="version"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="version" target="clock"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="clock" target="rule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="rule" target="shops"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="shops" target="sales"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="sales" target="calc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="calc" target="save"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="save" target="use"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="loop" value="รอบถัดไป" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b7791f;exitX=1;exitY=0.5;entryX=1;entryY=0.5;fontSize=16;" edge="1" parent="1" source="use" target="clock"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="977"/><mxPoint x="700" y="347"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
